# Copia este archivo a `.env.local` (ignorado por git).

# Base del API. Por defecto: http://172.22.10.3:1235
# VITE_API_BASE_URL=http://172.22.10.3:1235

# `live` habla con el backend real; `mock` intercepta con MSW (fixtures reales).
# El login exige credenciales válidas, así que `mock` es el modo por defecto de
# desarrollo hasta que se disponga de un usuario de prueba.
VITE_API_MODE=mock
